<Window x:Class="DockPanelSuite.Wpf.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docking="clr-namespace:DockPanelSuite.Wpf;assembly=WpfUI"
        Title="DockPanel Suite · WPF 工作台" Width="1360" Height="860" MinWidth="960" MinHeight="640"
        Background="{DynamicResource Dps.Background}" Foreground="{DynamicResource Dps.Foreground}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource Dps.Surface}" BorderBrush="{DynamicResource Dps.Border}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="8" BorderBrush="{DynamicResource Dps.Accent}" BorderThickness="1" Background="{DynamicResource Dps.Selected}" VerticalAlignment="Center">
          <TextBlock Text="D" Foreground="{DynamicResource Dps.Accent}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="DockPanel Suite" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="WPF WORKSPACE  /  工业视觉工作台示例" Foreground="{DynamicResource Dps.Muted}" FontSize="10" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="＋  新建文档" Click="NewDocument" Style="{DynamicResource Dps.Button}" Margin="4" />
          <Button Content="面板 ▾" Click="ChoosePane" Style="{DynamicResource Dps.Button}" Margin="4" />
          <Button x:Name="ThemeButton" Content="切换主题" Click="ToggleTheme" Style="{DynamicResource Dps.Button}" Margin="4" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="WORKSPACE" Foreground="{DynamicResource Dps.Muted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock Text="  /  检测工位 A  /  默认布局" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="重置布局" Click="ResetLayout" Style="{DynamicResource Dps.IconButton}" Margin="6,0" />
        <Button Content="恢复布局" Click="RestoreLayout" Style="{DynamicResource Dps.IconButton}" Margin="6,0" />
        <Button Content="保存布局" Click="SaveLayout" Style="{DynamicResource Dps.IconButton}" Margin="6,0" />
      </StackPanel>
    </Grid>
    <docking:DockWorkspace x:Name="Docking" Grid.Row="2" Margin="12,0,12,8" />
    <Border Grid.Row="3" Background="{DynamicResource Dps.Surface}" BorderBrush="{DynamicResource Dps.Border}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="●  READY" Foreground="{DynamicResource Dps.Success}" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" />
        <TextBlock x:Name="Status" Grid.Column="1" Text="工作台就绪" VerticalAlignment="Center" Margin="20,0" Foreground="{DynamicResource Dps.Muted}" />
        <TextBlock Grid.Column="2" Text="Ctrl+Tab 切换文档  ·  Ctrl+W 关闭  ·  Esc 收起面板" Foreground="{DynamicResource Dps.Muted}" VerticalAlignment="Center" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
