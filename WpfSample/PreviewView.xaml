<UserControl x:Class="DockPanelSuite.Wpf.Sample.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Dps.Surface}" Foreground="{DynamicResource Dps.Foreground}">
  <ScrollViewer x:Name="PreviewScroll" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource Dps.ScrollViewer}">
  <Grid MinHeight="400" Height="{Binding ViewportHeight, ElementName=PreviewScroll}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="检测预览" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="CAMERA 01  /  零件表面检测  /  示例数据" Foreground="{DynamicResource Dps.Muted}" FontSize="11" Margin="0,6,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource Dps.Selected}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
        <TextBlock Text="●  示例画布" Foreground="{DynamicResource Dps.Accent}" />
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#111A26" CornerRadius="6" ClipToBounds="True" MinHeight="230">
      <Viewbox Stretch="Uniform" Margin="18">
        <Canvas Width="600" Height="340">
          <Path Stroke="#25344A" StrokeThickness="1" Data="M0,85 L600,85 M0,170 L600,170 M0,255 L600,255 M100,0 L100,340 M200,0 L200,340 M300,0 L300,340 M400,0 L400,340 M500,0 L500,340" />
          <Rectangle Canvas.Left="102" Canvas.Top="63" Width="396" Height="218" RadiusX="28" RadiusY="28" Fill="#293B50" Stroke="#647B92" StrokeThickness="2" />
          <Rectangle Canvas.Left="133" Canvas.Top="94" Width="334" Height="156" RadiusX="12" RadiusY="12" Fill="#1B2B3D" Stroke="#3C526B" StrokeThickness="1" />
          <Ellipse Canvas.Left="163" Canvas.Top="137" Width="70" Height="70" Fill="#0F1926" Stroke="#758AA1" StrokeThickness="3" />
          <Ellipse Canvas.Left="367" Canvas.Top="137" Width="70" Height="70" Fill="#0F1926" Stroke="#758AA1" StrokeThickness="3" />
          <Rectangle Canvas.Left="146" Canvas.Top="120" Width="104" Height="104" Stroke="#67D9B4" StrokeThickness="2" StrokeDashArray="4,3" />
          <Rectangle Canvas.Left="350" Canvas.Top="120" Width="104" Height="104" Stroke="#67D9B4" StrokeThickness="2" StrokeDashArray="4,3" />
          <TextBlock Canvas.Left="148" Canvas.Top="100" Text="ROI 01" Foreground="#83E6C5" FontSize="11" />
          <TextBlock Canvas.Left="352" Canvas.Top="100" Text="ROI 02" Foreground="#83E6C5" FontSize="11" />
          <Path Stroke="#66C5FF" StrokeThickness="1" Data="M283,170 L317,170 M300,153 L300,187 M102,302 L498,302 M102,295 L102,309 M498,295 L498,309" />
          <TextBlock Canvas.Left="261" Canvas.Top="309" Text="48.02 mm" Foreground="#8ED1FF" FontSize="12" />
          <TextBlock Canvas.Left="12" Canvas.Top="12" Text="FRAME 000128" Foreground="#90A5BF" FontSize="11" />
        </Canvas>
      </Viewbox>
    </Border>
    <UniformGrid Grid.Row="2" Columns="3" Margin="0,16,0,0">
      <Border BorderBrush="{DynamicResource Dps.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="测量结果（示例）" Foreground="{DynamicResource Dps.Muted}" FontSize="10" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6,0,0"><TextBlock Text="48.02 mm" FontSize="22" FontWeight="SemiBold" /></Viewbox></StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource Dps.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="4,0">
        <StackPanel><TextBlock Text="处理耗时（示例）" Foreground="{DynamicResource Dps.Muted}" FontSize="10" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6,0,0"><TextBlock Text="24.8 ms" FontSize="22" FontWeight="SemiBold" /></Viewbox></StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource Dps.Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="8,0,0,0">
        <StackPanel><TextBlock Text="判定（示例）" Foreground="{DynamicResource Dps.Muted}" FontSize="10" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6,0,0"><TextBlock Text="PASS" Foreground="{DynamicResource Dps.Success}" FontSize="22" FontWeight="SemiBold" /></Viewbox></StackPanel>
      </Border>
    </UniformGrid>
  </Grid>
  </ScrollViewer>
</UserControl>
