<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.1;net6.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PackageId>DockPanelSuite.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Description>Native WPF docking workspace with document tabs, tool panes and floating windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>DockPanelSuite.Wpf</RootNamespace>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>
</Project>
