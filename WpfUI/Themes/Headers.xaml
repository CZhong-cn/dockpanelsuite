<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:DockPanelSuite.Wpf">
  <!-- Shared metrics can also be overridden in DockWorkspace.Resources. -->
  <Thickness x:Key="Dps.HeaderTitleMargin">5,2,8,2</Thickness>
  <Thickness x:Key="Dps.ToolPaneHeaderMargin">4,2,4,2</Thickness>
  <sys:Double x:Key="Dps.TabTitleMaxWidth">200</sys:Double>
  <sys:Double x:Key="Dps.ToolPaneTitleMaxWidth">Infinity</sys:Double>
  <Geometry x:Key="Dps.PinGeometry">M4,1 L12,1 M6,1 L6,6 L3,9 L3,10 L13,10 L13,9 L10,6 L10,1 M8,10 L8,15</Geometry>

  <Style x:Key="Dps.DockItemHeader" TargetType="local:DockItemHeader">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:DockItemHeader">
          <!-- Change column assignments here to reorder the title, pin and close. -->
          <Grid Background="Transparent" local:DockItemHeader.IsDragHandle="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" Background="{TemplateBinding Background}" IsHitTestVisible="False" />
            <TextBlock x:Name="Title" Grid.Column="0" Text="{Binding Item.Title, RelativeSource={RelativeSource TemplatedParent}}"
                       ToolTip="{Binding Item.Title, RelativeSource={RelativeSource TemplatedParent}}"
                       Margin="{DynamicResource Dps.HeaderTitleMargin}" MaxWidth="{DynamicResource Dps.TabTitleMaxWidth}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="SizeAll"
                       local:DockItemHeader.IsDragHandle="True" />
            <Button x:Name="Pin" Grid.Column="1" Visibility="Collapsed" Style="{DynamicResource Dps.IconButton}"
                    local:DockItemHeader.IsDragHandle="False"
                    ToolTip="自动隐藏整组 / Auto-hide group" AutomationProperties.Name="自动隐藏整组 / Auto-hide group"
                    Command="{x:Static local:DockItemHeader.TogglePinCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}">
              <Path x:Name="PinGlyph" Data="{DynamicResource Dps.PinGeometry}" Width="12" Height="14"
                    Stretch="Uniform" StrokeThickness="1.3" RenderTransformOrigin="0.5,0.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="Close" Grid.Column="2" Content="×" Style="{DynamicResource Dps.IconButton}"
                    local:DockItemHeader.IsDragHandle="False"
                    ToolTip="隐藏面板 / Close pane (Ctrl+F4)" AutomationProperties.Name="隐藏面板 / Close pane (Ctrl+F4)"
                    IsEnabled="{Binding Item.CanClose, RelativeSource={RelativeSource TemplatedParent}}"
                    Command="{x:Static local:DockItemHeader.CloseCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Item.ShowCloseButton, RelativeSource={RelativeSource Self}}" Value="False">
              <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsToolPaneHeader" Value="True">
              <Setter Property="Margin" Value="{DynamicResource Dps.ToolPaneHeaderMargin}" />
              <Setter TargetName="TitleColumn" Property="Width" Value="*" />
              <Setter TargetName="Title" Property="MaxWidth" Value="{DynamicResource Dps.ToolPaneTitleMaxWidth}" />
            </Trigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Float}"><Setter TargetName="Pin" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Left}"><Setter TargetName="Pin" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Right}"><Setter TargetName="Pin" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Top}"><Setter TargetName="Pin" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Bottom}"><Setter TargetName="Pin" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding Item.CanAutoHide, RelativeSource={RelativeSource Self}}" Value="False">
              <Setter TargetName="Pin" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.AutoHide}">
              <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
              <Setter TargetName="Pin" Property="ToolTip" Value="固定整组 / Pin group" />
              <Setter TargetName="Pin" Property="AutomationProperties.Name" Value="固定整组 / Pin group" />
              <Setter TargetName="PinGlyph" Property="RenderTransform"><Setter.Value><RotateTransform Angle="45" /></Setter.Value></Setter>
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsToolPaneHeader, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Item.IsActive, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource Dps.ActiveTabForeground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Item.State, RelativeSource={RelativeSource Self}}" Value="{x:Static local:DockState.Float}" />
                <Condition Binding="{Binding Item.IsActive, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Background" Value="{DynamicResource Dps.ActiveTabBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource Dps.ActiveTabForeground}" />
            </MultiDataTrigger>
            <Trigger SourceName="Pin" Property="IsMouseOver" Value="True"><Setter TargetName="Pin" Property="Foreground" Value="{DynamicResource Dps.Foreground}" /></Trigger>
            <Trigger SourceName="Close" Property="IsMouseOver" Value="True"><Setter TargetName="Close" Property="Foreground" Value="{DynamicResource Dps.Foreground}" /></Trigger>
            <Trigger Property="IsToolTab" Value="True">
              <Setter TargetName="Pin" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
