<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DockPanelSuite.Wpf">
  <Geometry x:Key="Dps.GuidePlateGeometry">M41,1 L79,1 79,32 88,41 119,41 119,79 88,79 79,88 79,119 41,119 41,88 32,79 1,79 1,41 32,41 41,32 Z</Geometry>
  <Geometry x:Key="Dps.GuideArrowLeft">M7,14 L12,10 12,18 Z</Geometry>
  <Geometry x:Key="Dps.GuideArrowRight">M17,14 L12,10 12,18 Z</Geometry>
  <Geometry x:Key="Dps.GuideArrowTop">M12,8 L8,13 16,13 Z</Geometry>
  <Geometry x:Key="Dps.GuideArrowBottom">M12,20 L8,15 16,15 Z</Geometry>
  <Geometry x:Key="Dps.GuideCenterMark">M4,3 L10,3 10,5 4,5 Z</Geometry>
  <Style x:Key="Dps.GuideOverlay" TargetType="Canvas">
    <Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Focusable" Value="False" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="停靠导航 / Docking guides" />
  </Style>
  <Style x:Key="Dps.GuidePlateStyle" TargetType="ContentControl">
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ContentControl">
        <Viewbox Stretch="Fill">
          <Canvas Width="120" Height="120">
            <Path Data="{DynamicResource Dps.GuidePlateGeometry}" StrokeThickness="1" StrokeLineJoin="Round"
                  Fill="{DynamicResource Dps.GuidePlate}" Stroke="{DynamicResource Dps.GuideBorder}">
              <Path.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" /></Path.Effect>
            </Path>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Dps.GuideTile" TargetType="local:DockGuideTile">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource Dps.GuideBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Dps.GuideBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Dps.GuideGlyph}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="local:DockGuideTile">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
          <Viewbox Margin="3">
            <Canvas Width="24" Height="24">
              <Rectangle x:Name="Frame" Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
              <Path Data="M2,6 L22,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
              <Rectangle x:Name="Pane" Width="20" Height="16" Canvas.Left="2" Canvas.Top="6"
                         Fill="{TemplateBinding Foreground}" Opacity="0.3" />
              <Path x:Name="Mark" Data="{DynamicResource Dps.GuideCenterMark}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="State" Value="Left"><Setter TargetName="Pane" Property="Width" Value="7" /><Setter TargetName="Mark" Property="Data" Value="{DynamicResource Dps.GuideArrowLeft}" /></Trigger>
          <Trigger Property="State" Value="Right"><Setter TargetName="Pane" Property="Canvas.Left" Value="15" /><Setter TargetName="Pane" Property="Width" Value="7" /><Setter TargetName="Mark" Property="Data" Value="{DynamicResource Dps.GuideArrowRight}" /></Trigger>
          <Trigger Property="State" Value="Top"><Setter TargetName="Pane" Property="Height" Value="5" /><Setter TargetName="Mark" Property="Data" Value="{DynamicResource Dps.GuideArrowTop}" /></Trigger>
          <Trigger Property="State" Value="Bottom"><Setter TargetName="Pane" Property="Canvas.Top" Value="16" /><Setter TargetName="Pane" Property="Height" Value="6" /><Setter TargetName="Mark" Property="Data" Value="{DynamicResource Dps.GuideArrowBottom}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Dps.GuideHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dps.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Dps.GuideHoverGlyph}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
