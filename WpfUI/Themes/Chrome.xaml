<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DockPanelSuite.Wpf">
  <Style x:Key="Dps.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dps.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Dps.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Dps.Hover}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Dps.Accent}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Dps.Selected}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Dps.IconButton" TargetType="Button" BasedOn="{StaticResource Dps.Button}">
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="5,1" />
    <Setter Property="MinWidth" Value="24" /><Setter Property="MinHeight" Value="24" />
  </Style>
  <Style x:Key="Dps.Workspace" TargetType="local:DockWorkspace">
    <Setter Property="FontFamily" Value="{DynamicResource Dps.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource Dps.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Dps.Foreground}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Dps.RailPanel" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Style.Triggers>
      <Trigger Property="local:DockChrome.Edge" Value="Top"><Setter Property="Orientation" Value="Horizontal" /></Trigger>
      <Trigger Property="local:DockChrome.Edge" Value="Bottom"><Setter Property="Orientation" Value="Horizontal" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dps.RailButton" TargetType="Button" BasedOn="{StaticResource Dps.Button}">
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ContentTemplate" Value="{DynamicResource Dps.RailTitle}" />
    <Style.Triggers>
      <Trigger Property="local:DockChrome.Edge" Value="Left"><Setter Property="LayoutTransform"><Setter.Value><RotateTransform Angle="-90" /></Setter.Value></Setter></Trigger>
      <Trigger Property="local:DockChrome.Edge" Value="Right"><Setter Property="LayoutTransform"><Setter.Value><RotateTransform Angle="-90" /></Setter.Value></Setter></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dps.RailGroup" TargetType="Border">
    <Setter Property="CornerRadius" Value="3" /><Setter Property="Margin" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Dps.Header}" />
  </Style>
  <Style x:Key="Dps.AutoHideFlyout" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" /><Setter Property="Margin" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Dps.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Dps.Accent}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
    <Style.Triggers>
      <Trigger Property="local:DockChrome.Edge" Value="Left"><Setter Property="HorizontalAlignment" Value="Left" /></Trigger>
      <Trigger Property="local:DockChrome.Edge" Value="Right"><Setter Property="HorizontalAlignment" Value="Right" /></Trigger>
      <Trigger Property="local:DockChrome.Edge" Value="Top"><Setter Property="VerticalAlignment" Value="Top" /></Trigger>
      <Trigger Property="local:DockChrome.Edge" Value="Bottom"><Setter Property="VerticalAlignment" Value="Bottom" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dps.DropPreview" TargetType="Border">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="BorderThickness" Value="2" /><Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Dps.Preview}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Dps.Accent}" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="Dps.DockSurface" TargetType="Grid">
    <Setter Property="Background" Value="{DynamicResource Dps.Background}" />
  </Style>
  <Style x:Key="Dps.FloatingContent" TargetType="DockPanel">
    <Setter Property="Background" Value="{DynamicResource Dps.Surface}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Dps.Foreground}" />
  </Style>
  <Style x:Key="Dps.FloatingWindow" TargetType="Window">
    <Setter Property="MinWidth" Value="{DynamicResource Dps.FloatingMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource Dps.FloatingMinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource Dps.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource Dps.FontSize}" />
    <Setter Property="Background" Value="{DynamicResource Dps.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Dps.Foreground}" />
    <Setter Property="ShowInTaskbar" Value="False" /><Setter Property="UseLayoutRounding" Value="True" />
  </Style>
</ResourceDictionary>
